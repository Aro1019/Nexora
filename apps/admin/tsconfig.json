{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@nexora/ui": ["../../packages/ui/src/index.ts"],
      "@nexora/db": ["../../packages/db/src/index.ts"],
      "@nexora/auth": ["../../packages/auth/src/index.ts"],
      "@nexora/types": ["../../packages/types/src/index.ts"],
      "@nexora/api": ["../../packages/api/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
