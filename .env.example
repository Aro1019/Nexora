# Database
DATABASE_URL="postgresql://nexora:nexora_dev@localhost:5432/nexora?schema=public"

# Better Auth
BETTER_AUTH_SECRET="generate-a-random-secret-here"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth — Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth — GitHub
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# S3 / MinIO (file storage)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="nexora"
S3_SECRET_KEY="nexora_dev"
S3_BUCKET="nexora-media"
S3_REGION="us-east-1"

# Redis
REDIS_URL="redis://localhost:6379"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# URL publique de l'app site (utilisée par l'aperçu et le flux RSS)
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Resend (notifications e-mail des soumissions de formulaires)
RESEND_API_KEY=""
# Adresse expéditeur. En développement, utilisez "onboarding@resend.dev".
# En production, utilisez un domaine vérifié sur resend.com.
RESEND_FROM="Nexora <onboarding@resend.dev>"

# Domaines personnalisés
# Cible CNAME attendue lors de la vérification d'un domaine personnalisé.
# Vide = la vérification se contente d'un CNAME ou d'un A présent.
CIBLE_DNS="cname.nexora.app"
